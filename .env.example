# Copie para .env e TROQUE todos os valores "troque-...".
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# --- MongoDB ---
MONGO_USUARIO=securapy
MONGO_SENHA=troque-mongo-senha-forte
MONGO_BANCO=securapy

# --- MySQL ---
MYSQL_ROOT_SENHA=troque-mysql-root-senha-forte
MYSQL_USUARIO=securapy
MYSQL_SENHA=troque-mysql-app-senha-forte
MYSQL_BANCO=securapy

# --- Segredos da API (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_SECRET=troque-por-outro-valor-aleatorio-longo
JWT_EXPIRA_MIN=60

# --- Operador administrador criado na 1ª subida (nível 5) ---
ADMIN_NOME=Administrador SOC
ADMIN_EMAIL=admin@cybershield.local
ADMIN_SENHA=troque-Admin@Senha2026

# --- Enriquecimento (ipinfo.io) ---
ENRIQUECIMENTO_ATIVO=true
IPINFO_TOKEN=

# --- LLM: auto (usa OpenAI se houver chave) | mock | openai ---
LLM_MODO=auto
OPENAI_API_KEY=
LLM_MODELO=gpt-4o-mini

# --- Outros ---
RETENCAO_DIAS=90
ALERTAS_TCP_ATIVO=true
COOKIE_SEGURO=false
